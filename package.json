{
  "name": "stock-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-local-e2e.mjs",
    "provider:spike": "node scripts/verify-provider-coverage.mjs",
    "db:start": "pnpm dlx supabase@2.116.0 start",
    "db:stop": "pnpm dlx supabase@2.116.0 stop",
    "db:reset": "pnpm dlx supabase@2.116.0 db reset --local",
    "db:test": "pnpm dlx supabase@2.116.0 test db",
    "db:test:linked": "pnpm run db:test:linked:foundation && pnpm run db:test:linked:auth && pnpm run db:test:linked:watchlist && pnpm run db:test:linked:research && pnpm run db:test:linked:dashboard && pnpm run db:test:linked:market-data",
    "db:test:linked:foundation": "pnpm dlx supabase@2.116.0 db query --linked --file supabase/tests/database_foundation.test.sql",
    "db:test:linked:auth": "pnpm dlx supabase@2.116.0 db query --linked --file supabase/tests/auth_rls.test.sql",
    "db:test:linked:watchlist": "pnpm dlx supabase@2.116.0 db query --linked --file supabase/tests/stocks_watchlist.test.sql",
    "db:test:linked:research": "pnpm dlx supabase@2.116.0 db query --linked --file supabase/tests/research_core.test.sql",
    "db:test:linked:dashboard": "pnpm dlx supabase@2.116.0 db query --linked --file supabase/tests/dashboard_read_models.test.sql",
    "db:test:linked:market-data": "pnpm dlx supabase@2.116.0 db query --linked --file supabase/tests/market_data_integration.test.sql",
    "db:types": "node scripts/generate-database-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-table": "^9.2.4",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.39.0",
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
