{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-monitor.local/schemas/gpw-opportunity-monitoring/1.0/schema.json",
  "title": "GPW Opportunity Monitoring Export",
  "description": "Kanoniczny kontrakt danych pomiędzy skillem Monitoruj GPW Okazje a aplikacją Stock Monitor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportType",
    "externalId",
    "generatedAt",
    "analysisDate",
    "market",
    "profile",
    "marketRegime",
    "scanSummary",
    "marketSources",
    "companies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "exportType": {
      "const": "gpw_opportunity_monitoring"
    },
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "analysisDate": {
      "type": "string",
      "format": "date"
    },
    "market": {
      "const": "GPW"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "marketRegime": {
      "$ref": "#/$defs/marketRegime"
    },
    "scanSummary": {
      "$ref": "#/$defs/scanSummary"
    },
    "marketSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/company"
      }
    }
  },
  "$defs": {
    "moneyRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "currency"
      ],
      "properties": {
        "from": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "to": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "priceZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "currency",
        "note"
      ],
      "properties": {
        "from": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "to": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseCurrency",
        "horizon",
        "riskTolerance",
        "capitalProtectionPriority",
        "gradualEntry",
        "dividendPreference",
        "maxDeepDiveCandidates",
        "accountTypes",
        "preferredSectors",
        "excludedSectors",
        "customConstraints",
        "portfolioContext"
      ],
      "properties": {
        "baseCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "horizon": {
          "type": "string",
          "minLength": 1
        },
        "riskTolerance": {
          "enum": [
            "LOW",
            "MODERATE",
            "ELEVATED",
            "HIGH",
            "CUSTOM"
          ]
        },
        "capitalProtectionPriority": {
          "type": "boolean"
        },
        "gradualEntry": {
          "type": "boolean"
        },
        "dividendPreference": {
          "type": "boolean"
        },
        "maxDeepDiveCandidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "accountTypes": {
          "type": "array",
          "items": {
            "enum": [
              "IKE",
              "IKZE",
              "TAXABLE",
              "OTHER"
            ]
          },
          "uniqueItems": true
        },
        "preferredSectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedSectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "portfolioContext": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "holdings"
              ],
              "properties": {
                "holdings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "market",
                      "ticker",
                      "costBasis",
                      "currency",
                      "note"
                    ],
                    "properties": {
                      "market": {
                        "type": "string"
                      },
                      "ticker": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      },
                      "costBasis": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "currency": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[A-Z]{3}$"
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "marketRegime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valuationRegime",
        "marketPhase",
        "opportunityBreadth",
        "summary",
        "keyRisks",
        "implicationsForScreening"
      ],
      "properties": {
        "valuationRegime": {
          "enum": [
            "DEEPLY_UNDERVALUED",
            "BELOW_HISTORICAL_AVERAGE",
            "NEAR_HISTORICAL_AVERAGE",
            "ABOVE_HISTORICAL_AVERAGE",
            "EXPENSIVE",
            "UNKNOWN"
          ]
        },
        "marketPhase": {
          "enum": [
            "BROAD_BULL",
            "SELECTIVE_MARKET",
            "CORRECTION",
            "BEAR_MARKET",
            "TRANSITION",
            "UNKNOWN"
          ]
        },
        "opportunityBreadth": {
          "enum": [
            "BROAD",
            "SELECTIVE",
            "NARROW",
            "NONE",
            "UNKNOWN"
          ]
        },
        "summary": {
          "type": "string"
        },
        "keyRisks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implicationsForScreening": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scanSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companiesScreened",
        "companiesConsidered",
        "companiesExported",
        "deepDiveCandidates",
        "buyCandidates",
        "watchCandidates",
        "avoidCandidates",
        "summary"
      ],
      "properties": {
        "companiesScreened": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "companiesConsidered": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "companiesExported": {
          "type": "integer",
          "minimum": 0
        },
        "deepDiveCandidates": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "buyCandidates": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "watchCandidates": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "avoidCandidates": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "summary": {
          "type": "string"
        }
      },
      "$comment": "Walidacja semantyczna: companiesExported musi być równe długości companies[]."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "name",
        "market",
        "currency",
        "isin"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,16}$",
          "not": {
            "pattern": "\\."
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "const": "GPW"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "isin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason",
        "watchReason"
      ],
      "properties": {
        "action": {
          "enum": [
            "BUY_GRADUALLY",
            "WATCH",
            "HOLD",
            "REDUCE",
            "AVOID"
          ]
        },
        "reason": {
          "type": "string"
        },
        "watchReason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "opportunityCategory"
      ],
      "properties": {
        "status": {
          "enum": [
            "BUY_CANDIDATE",
            "WATCH",
            "WAIT_FOR_CORRECTION",
            "DEEP_DIVE",
            "HOLD",
            "REDUCE",
            "AVOID",
            "KILL_THE_THESIS"
          ]
        },
        "opportunityCategory": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "QUALITY_COMPOUNDER",
            "GROWTH_AT_REASONABLE_PRICE",
            "DIVIDEND_QUALITY",
            "EARNINGS_INFLECTION",
            "SUPPLY_ANOMALY",
            "SMALL_CAP_SELECTIVE",
            "SPECIAL_SITUATION",
            "WATCH_WITHOUT_PRICE_EDGE",
            null
          ]
        }
      }
    },
    "scoreComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "businessModelAndRecurringRevenue",
        "competitiveAdvantage",
        "earningsQualityAndCashConversion",
        "epsFcfGrowthVisibility",
        "balanceSheetAndFinancialResilience",
        "managementOwnershipCapitalAllocation",
        "industryOutlookAndTargetMarket",
        "narrativeToNumbers",
        "valuationAndMarginOfSafety",
        "riskRewardAsymmetry",
        "trendTimingSupplyAnomaly",
        "liquidityGovernanceRiskDataQuality"
      ],
      "properties": {
        "businessModelAndRecurringRevenue": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "competitiveAdvantage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "earningsQualityAndCashConversion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "epsFcfGrowthVisibility": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 12
        },
        "balanceSheetAndFinancialResilience": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8
        },
        "managementOwnershipCapitalAllocation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8
        },
        "industryOutlookAndTargetMarket": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 7
        },
        "narrativeToNumbers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "valuationAndMarginOfSafety": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "riskRewardAsymmetry": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 8
        },
        "trendTimingSupplyAnomaly": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        },
        "liquidityGovernanceRiskDataQuality": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "components"
      ],
      "properties": {
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "components": {
          "$ref": "#/$defs/scoreComponents"
        }
      },
      "$comment": "Walidacja semantyczna: jeśli total != null, wszystkie komponenty muszą być liczbami, a ich suma musi być równa total."
    },
    "marketData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "currency",
        "asOf",
        "source"
      ],
      "properties": {
        "price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "asOf": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "valuationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "fairValue",
        "currency",
        "summary"
      ],
      "properties": {
        "method": {
          "enum": [
            "DCF",
            "DDM",
            "PE",
            "EV_EBITDA",
            "EV_EBIT",
            "P_FCF",
            "P_BV",
            "SOTP",
            "HISTORICAL_MULTIPLES",
            "PEERS",
            "SECTOR_SPECIFIC",
            "OTHER"
          ]
        },
        "fairValue": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "methods",
        "fairValueBase",
        "attractiveEntryZone",
        "marginOfSafetySummary"
      ],
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valuationMethod"
          }
        },
        "fairValueBase": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "attractiveEntryZone": {
          "$ref": "#/$defs/moneyRange"
        },
        "marginOfSafetySummary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revenueGrowthAssumption",
        "marginAssumption",
        "epsOrFcfAssumption",
        "sectorMetricAssumption",
        "terminalAssumption",
        "dividendsExpected",
        "fairValue",
        "currency",
        "totalReturnPct",
        "annualizedReturnPct",
        "probabilityPct"
      ],
      "properties": {
        "revenueGrowthAssumption": {
          "type": [
            "string",
            "null"
          ]
        },
        "marginAssumption": {
          "type": [
            "string",
            "null"
          ]
        },
        "epsOrFcfAssumption": {
          "type": [
            "string",
            "null"
          ]
        },
        "sectorMetricAssumption": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminalAssumption": {
          "type": [
            "string",
            "null"
          ]
        },
        "dividendsExpected": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fairValue": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "totalReturnPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "annualizedReturnPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "probabilityPct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bear",
        "base",
        "bull"
      ],
      "properties": {
        "bear": {
          "$ref": "#/$defs/scenario"
        },
        "base": {
          "$ref": "#/$defs/scenario"
        },
        "bull": {
          "$ref": "#/$defs/scenario"
        }
      },
      "$comment": "Walidacja semantyczna: jeśli wszystkie probabilityPct są znane, ich suma powinna wynosić 100 (z tolerancją na zaokrąglenia)."
    },
    "expectedReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizonYears",
        "baseTotalReturnPct",
        "baseAnnualizedReturnPct",
        "bullTotalReturnPct",
        "bearDownsidePct",
        "weightedExpectedReturnPct",
        "returnDrivers",
        "asymmetryRatio",
        "summary"
      ],
      "properties": {
        "horizonYears": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "baseTotalReturnPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "baseAnnualizedReturnPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "bullTotalReturnPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "bearDownsidePct": {
          "type": [
            "number",
            "null"
          ]
        },
        "weightedExpectedReturnPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "returnDrivers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "epsFcfGrowthPct",
            "dividendPct",
            "multipleChangePct"
          ],
          "properties": {
            "epsFcfGrowthPct": {
              "type": [
                "number",
                "null"
              ]
            },
            "dividendPct": {
              "type": [
                "number",
                "null"
              ]
            },
            "multipleChangePct": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "asymmetryRatio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "narrativeBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalyst",
        "economicMechanism",
        "operationalImpact",
        "revenueImpact",
        "marginOrEbitImpact",
        "epsFcfImpact",
        "workingCapitalAndCapexImpact",
        "expectedTiming",
        "probability",
        "alreadyPricedIn"
      ],
      "properties": {
        "catalyst": {
          "type": "string"
        },
        "economicMechanism": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationalImpact": {
          "type": [
            "string",
            "null"
          ]
        },
        "revenueImpact": {
          "type": [
            "string",
            "null"
          ]
        },
        "marginOrEbitImpact": {
          "type": [
            "string",
            "null"
          ]
        },
        "epsFcfImpact": {
          "type": [
            "string",
            "null"
          ]
        },
        "workingCapitalAndCapexImpact": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedTiming": {
          "type": [
            "string",
            "null"
          ]
        },
        "probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "alreadyPricedIn": {
          "enum": [
            "YES",
            "PARTLY",
            "NO",
            "UNKNOWN"
          ]
        }
      }
    },
    "businessQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "businessModel",
        "revenueAndProfitSources",
        "recurringRevenue",
        "customerSegmentsAndGeography",
        "cyclicality",
        "pricingPower",
        "competitiveAdvantages",
        "advantageDurability",
        "advantageThreats",
        "marketOpportunity",
        "managementAndCapitalAllocation"
      ],
      "properties": {
        "businessModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "revenueAndProfitSources": {
          "type": [
            "string",
            "null"
          ]
        },
        "recurringRevenue": {
          "type": [
            "string",
            "null"
          ]
        },
        "customerSegmentsAndGeography": {
          "type": [
            "string",
            "null"
          ]
        },
        "cyclicality": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricingPower": {
          "type": [
            "string",
            "null"
          ]
        },
        "competitiveAdvantages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advantageDurability": {
          "type": [
            "string",
            "null"
          ]
        },
        "advantageThreats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marketOpportunity": {
          "type": [
            "string",
            "null"
          ]
        },
        "managementAndCapitalAllocation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "margins": {
      "type": "object",
      "additionalProperties": false,
